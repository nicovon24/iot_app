// Hybrid tables only — ThingsBoard-native entities are NOT duplicated here.
// Authoritative schema for PostgreSQL metadata layer.

Project platform_iot {
  database_type: 'PostgreSQL'
  Note: 'Custom tables complement ThingsBoard. All tb_* fields reference ThingsBoard entity IDs.'
}

Table hierarchy_level_definitions {
  id uuid [pk]
  tb_customer_id uuid [not null, note: 'ThingsBoard Customer (Client) ID']
  level_order int [not null, note: '1 = first intermediate level below Client']
  label varchar [not null, note: 'Display name, e.g. Location, Country, Data Center']
  icon varchar [note: 'Optional icon key for frontend']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (tb_customer_id, level_order) [unique]
  }
}

Table relation_type_definitions {
  id uuid [pk]
  tb_customer_id uuid [not null, note: 'ThingsBoard Customer (Client) ID']
  relation_type varchar [not null, note: 'Matches a ThingsBoard native Relation type string, e.g. Feeds, Powers, Monitors. "Contains" is reserved for hierarchy and not listed here.']
  label varchar [not null, note: 'Display name shown in frontend']
  icon varchar [note: 'Optional icon key for frontend']
  created_at timestamptz [default: `now()`]

  indexes {
    (tb_customer_id, relation_type) [unique]
  }
}

Enum widget_type {
  chart
  card
  gauge
  badge
  map
  table
}

Table telemetry_definitions {
  id uuid [pk]
  sensor_telemetry varchar [not null, unique, note: 'Logical telemetry type, matches raw TB key today (temperature, pressure, flowRate...)']
  category_id uuid [not null, ref: > unit_categories.id]
  decimals smallint [not null, default: 2]
  min numeric
  max numeric [note: 'min/max nullable — can be derived dynamically from history instead of fixed']
  default_widget widget_type [not null]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table unit_categories {
  id uuid [pk]
  name varchar [not null, unique, note: 'e.g. temperature, pressure, flow, energy']
  base_unit varchar [not null, note: 'Unit telemetry is stored in, e.g. °C']
  created_at timestamptz [default: `now()`]
}

Table unit_conversions {
  id uuid [pk]
  category_id uuid [not null, ref: > unit_categories.id]
  unit_code varchar [not null, note: 'e.g. °F, K']
  label varchar [not null]
  factor numeric [not null, default: 1, note: 'display = stored * factor + offset']
  offset numeric [not null, default: 0]
  created_at timestamptz [default: `now()`]

  indexes {
    (category_id, unit_code) [unique]
  }
}

Table user_unit_preferences {
  id uuid [pk]
  tb_user_id uuid [not null]
  category_id uuid [not null, ref: > unit_categories.id]
  unit_code varchar [not null, note: 'Must exist in unit_conversions for this category, or equal unit_categories.base_unit']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (tb_user_id, category_id) [unique]
  }
}

Table dashboard_configs {
  id uuid [pk]
  tb_customer_id uuid [not null]
  tb_entity_id uuid [note: 'Optional hierarchy node scope']
  name varchar [not null]
  dashboard_type varchar [not null, note: 'entity | solution | custom']
  config jsonb [not null, note: 'Layout, widgets, data bindings. Shape below (validated with Zod on write, not enforced by Postgres).']
  is_default boolean [default: false]
  created_by uuid [not null, note: 'ThingsBoard user ID. Creator always retains view/edit regardless of visible_to_role_id.']
  visible_to_role_id uuid [ref: > roles.id, note: 'Target audience for this dashboard. Null = follows dashboard_type default visibility instead of a specific role.']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// dashboard_configs.config shape (react-grid-layout + widget bindings):
// {
//   "layout": [
//     { "widgetId": "uuid", "x": 0, "y": 0, "w": 4, "h": 3 }
//   ],
//   "widgets": {
//     "<widgetId>": {
//       "type": widget_type enum value (chart | card | gauge | badge | map | table),
//       "tb_entity_id": "uuid",           // device or asset
//       "sensor_telemetry": "temperature", // matches telemetry_definitions.sensor_telemetry
//       "widget_type_override": "gauge",  // optional, overrides telemetry_definitions.default_widget only
//       "time_range": "1h" | "24h" | "7d" | "30d" | "custom",
//       "aggregation": "avg" | "min" | "max" | "none"
//     }
//   }
// }
// Notes:
// - unit, decimals, min, max are NEVER stored here — always resolved from telemetry_definitions/unit_categories at render time.
// - Telemetry values themselves live only in ThingsBoard; nothing telemetry-related is duplicated here.
// - widgetId keys in "widgets" must match a "widgetId" entry in "layout" (1:1).

Table favorites {
  id uuid [pk]
  tb_user_id uuid [not null]
  resource_type varchar [not null, note: 'dashboard | entity | telemetry_view']
  resource_id uuid [not null]
  pin_order int
  created_at timestamptz [default: `now()`]

  indexes {
    (tb_user_id, resource_type, resource_id) [unique]
  }
}

Table alarm_recipients {
  id uuid [pk]
  tb_rule_node_id uuid [not null, note: 'ThingsBoard Rule Chain node ID']
  email varchar [not null]
  created_at timestamptz [default: `now()`]

  indexes {
    (tb_rule_node_id, email) [unique]
  }
}

Table roles {
  id uuid [pk]
  name varchar [not null, note: 'e.g. manager, operator, admin — free-form per Client']
  tb_entity_id uuid [not null, note: 'Generic scope — any TB entity']
  permissions jsonb [not null, note: 'Governs dashboard visibility (entity/solution/custom) for this role — does not restrict widget types, which are the same for all users. Shape: { "dashboards": { "view_default_types": ["entity","solution"], "view_dashboard_ids": ["uuid", ...] } }. dashboard_configs.visible_to_role_id targets a specific dashboard at a role directly; this jsonb covers the general/default-type case.']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table user_role_assignments {
  id uuid [pk]
  tb_user_id uuid [not null]
  role_id uuid [not null, ref: > roles.id]
  created_at timestamptz [default: `now()`]

  indexes {
    (tb_user_id, role_id) [unique]
  }
}
