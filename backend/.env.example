# ThingsBoard — needs the scheme. config.schema.ts validates with Zod .url(),
# so a bare hostname fails at startup.
THINGSBOARD_URL=https://thingsboard.cloud
THINGSBOARD_USERNAME=your-thingsboard-user@example.com
THINGSBOARD_PASSWORD=your-thingsboard-password

# Port 15432, not 5432: docker-compose remaps the Postgres container so it
# doesn't collide with a locally installed Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/iot_app

# Note the leading colon: Redis has no username, so the password sits between
# "//" and "@". Must match REDIS_PASSWORD in docker-compose.yml.
REDIS_URL=redis://:devpassword@localhost:6379
PORT=3001

# Optional — allowed CORS origin, defaults to http://localhost:3000
# FRONTEND_URL=http://localhost:3000
