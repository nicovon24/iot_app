# ThingsBoard — needs the scheme. config.schema.ts validates with Zod .url(),
# so a bare hostname fails at startup.
THINGSBOARD_URL=https://thingsboard.cloud
# Additional approved login origins, comma separated. The default URL is always approved.
# THINGSBOARD_ALLOWED_URLS=https://demo.thingsboard.io

# Only the optional seed-movement script uses these credentials.
# SEED_THINGSBOARD_USERNAME=your-thingsboard-user@example.com
# SEED_THINGSBOARD_PASSWORD=your-thingsboard-password

# Port 15432, not 5432: docker-compose remaps the Postgres container so it
# doesn't collide with a locally installed Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/iot_app

# Note the leading colon: Redis has no username, so the password sits between
# "//" and "@". Must match REDIS_PASSWORD in docker-compose.yml.
REDIS_URL=redis://:devpassword@localhost:6379
PORT=3001

# Optional — allowed CORS origin, defaults to http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# AI credentials are encrypted with a 32-byte hexadecimal key kept outside PostgreSQL.
# AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
# Approved HTTPS origins for user-configured OpenAI-compatible endpoints.
# AI_ALLOWED_BASE_URLS=https://llm.example.com
